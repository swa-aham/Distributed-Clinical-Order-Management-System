{
  "info": {
    "name": "Clinical Order Management System",
    "description": "API collection for testing all three microservices",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "orderServiceUrl",        "value": "http://localhost:8081" },
    { "key": "pharmacyServiceUrl",     "value": "http://localhost:8082" },
    { "key": "notificationServiceUrl", "value": "http://localhost:8083" },
    { "key": "patientId",  "value": "11111111-1111-1111-1111-111111111111" },
    { "key": "doctorId",   "value": "22222222-2222-2222-2222-222222222222" },
    { "key": "orderId",    "value": "" }
  ],
  "item": [
    {
      "name": "Order Service",
      "item": [
        {
          "name": "Create MEDICATION Order",
          "event": [{ "listen": "test", "script": { "exec": [
            "var json = pm.response.json();",
            "pm.collectionVariables.set('orderId', json.orderId);",
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "pm.test('Status is PENDING', () => pm.expect(json.status).to.eql('PENDING'));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"{{patientId}}\",\n  \"doctorId\": \"{{doctorId}}\",\n  \"orderType\": \"MEDICATION\",\n  \"notes\": \"Prescribed for bacterial infection\"\n}"
            },
            "url": "{{orderServiceUrl}}/api/orders"
          }
        },
        {
          "name": "Create LAB_TEST Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"{{patientId}}\",\n  \"doctorId\": \"{{doctorId}}\",\n  \"orderType\": \"LAB_TEST\",\n  \"notes\": \"Blood panel\"\n}"
            },
            "url": "{{orderServiceUrl}}/api/orders"
          }
        },
        {
          "name": "Get Order by ID",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "method": "GET",
            "url": "{{orderServiceUrl}}/api/orders/{{orderId}}"
          }
        },
        {
          "name": "Get All Orders",
          "request": {
            "method": "GET",
            "url": "{{orderServiceUrl}}/api/orders"
          }
        },
        {
          "name": "Get Orders by Patient",
          "request": {
            "method": "GET",
            "url": "{{orderServiceUrl}}/api/orders/patient/{{patientId}}"
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "PATCH",
            "url": "{{orderServiceUrl}}/api/orders/{{orderId}}/cancel"
          }
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{orderServiceUrl}}/actuator/health"
          }
        }
      ]
    },
    {
      "name": "Pharmacy Service",
      "item": [
        {
          "name": "Get All Medications",
          "request": {
            "method": "GET",
            "url": "{{pharmacyServiceUrl}}/api/pharmacy/medications"
          }
        },
        {
          "name": "Get All Reservations",
          "request": {
            "method": "GET",
            "url": "{{pharmacyServiceUrl}}/api/pharmacy/reservations"
          }
        },
        {
          "name": "Get Reservation by Order ID",
          "request": {
            "method": "GET",
            "url": "{{pharmacyServiceUrl}}/api/pharmacy/reservations/order/{{orderId}}"
          }
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{pharmacyServiceUrl}}/actuator/health"
          }
        }
      ]
    },
    {
      "name": "Notification Service",
      "item": [
        {
          "name": "Get All Notifications",
          "request": {
            "method": "GET",
            "url": "{{notificationServiceUrl}}/api/notifications"
          }
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{notificationServiceUrl}}/actuator/health"
          }
        }
      ]
    }
  ]
}
