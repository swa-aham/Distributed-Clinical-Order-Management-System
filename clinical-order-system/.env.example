# ============================================================
# Clinical Order Management System — Environment Variables
# Copy this file to .env and fill in your values.
# Each service reads these at startup via OS env vars.
# ============================================================

# ─── Kafka ────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── Order Service Database ───────────────────────────────
# Local Docker:
ORDER_DB_URL=jdbc:postgresql://localhost:5432/clinical_orders
# Supabase example:
# ORDER_DB_URL=jdbc:postgresql://db.<project>.supabase.co:5432/postgres

ORDER_DB_USERNAME=postgres
ORDER_DB_PASSWORD=postgres

# ─── Pharmacy Service Database ────────────────────────────
PHARMACY_DB_URL=jdbc:postgresql://localhost:5432/clinical_pharmacy
PHARMACY_DB_USERNAME=postgres
PHARMACY_DB_PASSWORD=postgres

# ─── How to use ───────────────────────────────────────────
# Option A: Export before running
#   export DB_URL=$ORDER_DB_URL && export DB_USERNAME=$ORDER_DB_USERNAME ...
#   cd order-service && mvn spring-boot:run
#
# Option B: Pass directly to Maven
#   mvn spring-boot:run -Dspring-boot.run.jvmArguments="-DDB_URL=... -DDB_USERNAME=..."
#
# Option C: IntelliJ / IDE — set environment variables in run configuration
